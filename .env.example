# --- Token du bot Discord ---
DISCORD_TOKEN=

# --- Identité du bot ---
BOT_NAME=v-bot
BOT_PREFIX=v!
BOT_VERSION = 3.7.5

# --- Owner principal (1 seul ID, obligatoire) ---
OWNER_PRINCIPAL_ID=

# --- Owners secondaires (autant que tu veux, séparés par des virgules) ---
# Exemple : OWNERS_SECONDARY_IDS=111111111111111111,222222222222222222
OWNERS_SECONDARY_IDS=

# --- Commandes sensibles (raid, remove_raid, dmall, spam) ---
# Désactivées par défaut. Bascule via le panel start_bot.bat (commande
# toggle_dangerous), pas en éditant ce fichier directement.
DANGEROUS_COMMANDS_ENABLED=false
