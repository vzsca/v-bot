# --- Discord bot token ---
DISCORD_TOKEN=

# --- Bot identity ---
BOT_PREFIX=v!

# --- Principal owner (1 ID only, required) ---
OWNER_PRINCIPAL_ID=

# --- Secondary owners (maximum 5, comma-separated) ---
# Example: OWNERS_SECONDARY_IDS=111111111111111111,222222222222222222
OWNERS_SECONDARY_IDS=

# --- Sensitive commands ---
DANGEROUS_COMMANDS_ENABLED=false

# --- Main API credentials ---
# Used only by guilds explicitly authorized from the owner panel.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=

# --- Instagram Graph API (eligible professional account) ---
# Use a valid token with permission to read Instagram account media.
# Used only for guilds authorized to use the primary API in api_config_access.json
INSTAGRAM_ACCESS_TOKEN=
# Instagram professional account ID, not the @username.
INSTAGRAM_USER_ID=
