# --- Discord bot token ---
DISCORD_TOKEN=

# --- Bot identity ---
BOT_PREFIX=v!

# --- Principal owner (1 ID only, required) ---
OWNER_PRINCIPAL_ID=

# --- Secondary owners (as many as you want, comma-separated) ---
# Example: OWNERS_SECONDARY_IDS=111111111111111111,222222222222222222
OWNERS_SECONDARY_IDS=

# --- Sensitive commands ---
DANGEROUS_COMMANDS_ENABLED=false

# --- Shared API credentials (used ONLY by guilds authorized in v!servers) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=

# --- Per-guild API credentials (used by guilds NOT authorized for panel API) ---
# Replace <GUILD_ID> with the Discord server ID.
# TWITCH_CLIENT_ID_<GUILD_ID>=
# TWITCH_CLIENT_SECRET_<GUILD_ID>=
# YOUTUBE_API_KEY_<GUILD_ID>=
